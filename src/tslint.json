{
  "extends": "../tslint.json",
  "rules": {
    "directive-selector": [
      true,
      "attribute",
      "app",
      "camelCase"
    ],
    "component-selector": [
      true,
      "element",
      "app",
      "kebab-case"
    ],

    "no-console": [
      true,
      "log",
      "debug",
      "info",
      "time",
      "timeEnd",
      "trace"
    ],

    ":semicolon": [
      true,
      "always"
    ],

    "quotemark": [
      true,
      "single",
      "avoid-escape"
    ],

    "trailing-comma": [
      true,
      {
        "multiline": {
          "objects": "always",
          "arrays": "always",
          "functions": "never",
          "typeLiterals": "ignore"
        },
        "singleline": "never"
      }
    ],

    "object-literal-sort-keys": false,

    "member-access": [
      true,
      "check-accessor"
    ],

    "ordered-imports": [
      true,
      {
        "grouped-imports": true,
        "import-sources-order": "case-insensitive"
      }
    ],

    "arrow-parens": [
      true,
      "ban-single-arg-parens"
    ],

    "interface-name": [
      true,
      "never-prefix"
    ],

    "max-line-length": [
      true,
      120
    ],

    "no-var-keyword": true,

    "prefer-const": true,

    "typedef-whitespace": [
      true,
      {
        "call-signature": "nospace",
        "index-signature": "nospace",
        "parameter": "nospace",
        "property-declaration": "nospace",
        "variable-declaration": "nospace"
      }
    ]
  }
}
